SHELL := /usr/bin/env bash

export PATH := $(PATH):$(shell go env GOPATH)/bin
export GO111MODULE=on
LDFLAGS := -s -w

.PHONY: web frps-web frpc-web app android-aar

# 默认输出 AAR 路径和 Java 包名，可通过环境变量覆盖：
#   make -f Makefile.cross-compiles ANDROID_AAR=./release/custom.aar ANDROID_JAVAPKG=com.xxx.yyy
# 最终带 classes.dex 的 AAR 路径（目录 + 文件名）
ANDROID_AAR ?= ./release/frp.aar
ANDROID_JAVAPKG ?= com.android.http
# gomobile 默认 -androidapi 16。NDK r26 及更新版本最低只支持 21，不指定会被拒绝。
ANDROID_API ?= 21

# 目录、最终文件名、原始 gomobile 产物文件名
ANDROID_AAR_DIR := $(dir $(ANDROID_AAR))
ANDROID_AAR_FILE := $(notdir $(ANDROID_AAR))
ANDROID_AAR_RAW_FILE := frp_raw.aar

os-archs := darwin:amd64 darwin:arm64 freebsd:amd64 openbsd:amd64 linux:amd64 linux:arm:7 linux:arm:5 linux:arm64 windows:amd64 windows:arm64 linux:mips64 linux:mips64le linux:mips:softfloat linux:mipsle:softfloat linux:riscv64 linux:loong64 android:arm64

all: build

# 先构建前端 dist，再构建各平台二进制和 Android AAR
build: web app android-aar

web: frps-web frpc-web

frps-web:
	@$(MAKE) -C web/frps install build

frpc-web:
	@$(MAKE) -C web/frpc install build

app:
	@for n in $(os-archs); do \
		os=$$(echo "$$n" | cut -d : -f 1); \
		arch=$$(echo "$$n" | cut -d : -f 2); \
		extra=$$(echo "$$n" | cut -d : -f 3); \
		flags=""; \
		target_suffix="$${os}_$${arch}"; \
		bin_ext=""; \
		if [ "$$os" = "windows" ]; then bin_ext=".exe"; fi; \
		if [ "$$os" = "linux" ] && [ "$$arch" = "arm" ] && [ "$$extra" != "" ]; then \
			if [ "$$extra" = "7" ]; then \
				flags="GOARM=7"; \
				target_suffix="$${os}_arm_hf"; \
			elif [ "$$extra" = "5" ]; then \
				flags="GOARM=5"; \
				target_suffix="$${os}_arm"; \
			fi; \
		elif [ "$$os" = "linux" ] && ([ "$$arch" = "mips" ] || [ "$$arch" = "mipsle" ]) && [ "$$extra" != "" ]; then \
			flags="GOMIPS=$${extra}"; \
		fi; \
		if [ "$$os" = "android" ]; then \
			build_ldflags="$(LDFLAGS) -checklinkname=0"; \
		else \
			build_ldflags="$(LDFLAGS)"; \
		fi; \
		echo "Build $$os-$$arch$${extra:+ ($$extra)}..."; \
		cd "$(CURDIR)" && env CGO_ENABLED=0 GOOS=$$os GOARCH=$$arch $$flags go build -trimpath -ldflags "$$build_ldflags" -tags frpc -o "./release/frpc_$${target_suffix}$${bin_ext}" ./cmd/frpc; \
		cd "$(CURDIR)" && env CGO_ENABLED=0 GOOS=$$os GOARCH=$$arch $$flags go build -trimpath -ldflags "$$build_ldflags" -tags frps -o "./release/frps_$${target_suffix}$${bin_ext}" ./cmd/frps; \
		echo "Build $$os-$$arch$${extra:+ ($$extra)} done"; \
	done

android-aar:
	@echo "Build Android raw AAR (gomobile bind)..."
	@mkdir -p "$(ANDROID_AAR_DIR)"
	@env CGO_ENABLED=1 GOOS=android gomobile bind -ldflags="$(LDFLAGS) -checklinkname=0" -target=android -androidapi $(ANDROID_API) -javapkg $(ANDROID_JAVAPKG) -o "$(ANDROID_AAR_DIR)/$(ANDROID_AAR_RAW_FILE)" github.com/fatedier/frp/cmd/frp/frps github.com/fatedier/frp/cmd/frp/frpc
	@echo "Convert raw AAR to dex AAR ($(ANDROID_AAR_FILE))..."
	@./make_frp_dex_aar.sh "$(ANDROID_AAR_DIR)" "$(ANDROID_AAR_RAW_FILE)" "$(ANDROID_AAR_FILE)"
